<dialog id="detail">
  <div class="modal">
    <header>
      <h2 id="d-name"></h2>
      <button class="close" id="close">Close</button>
    </header>
    <div class="art">
      <div class="glow"></div>
      <img id="d-art" class="shine" alt="Official artwork" />
    </div>
    <div class="meta">
      <div class="rowline" style="justify-content:space-between">
        <div class="rowline" id="d-types"></div>
        <div class="rowline" style="gap:12px">
          <span id="d-id" class="pk-id"></span>
          <span id="d-height" class="pk-id"></span>
          <span id="d-weight" class="pk-id"></span>
        </div>
      </div>
      <h3>Base Stats</h3>
      <div id="d-stats"></div>
      <h3>Abilities</h3>
      <div class="abilities" id="d-abilities"></div>
      <h3>Flavor</h3>
      <p id="d-flavor" class="flavor"></p>
      <h3>Evolution</h3>
      <div id="d-evo" class="evo"></div>
    </div>
  </div>
</dialog>
