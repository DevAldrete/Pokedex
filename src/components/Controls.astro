<div class="controls">
  <input id="search" class="input" placeholder="Search name or #ID…" aria-label="Search Pokémon" />
  <select id="typeFilter" aria-label="Filter by type">
    <option value="">All types</option>
  </select>
  <select id="sorter" aria-label="Sort">
    <option value="id-asc">Sort: ID ↑</option>
    <option value="id-desc">Sort: ID ↓</option>
    <option value="name-asc">Sort: Name A→Z</option>
    <option value="name-desc">Sort: Name Z→A</option>
  </select>
  <label class="row" style="gap:6px; align-items:center">
    <input type="checkbox" id="shinyToggle" /> Shiny
  </label>
  <button id="reset" class="btn">Reset</button>
</div>
