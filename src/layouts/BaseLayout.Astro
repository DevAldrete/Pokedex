---
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://pokeapi.co" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/globals.css";
</style>

<script>
  import "../scripts/pokedex.js";
</script>
